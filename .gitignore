# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables (security)
.env
.env.local
.env.*.local

# Secrets / credentials — never commit these, even to a private repo
*.pem
*.key
*.crt
*.cer
*.p12
*.mobileprovision
.npmrc
.netrc

# One-shot setup scripts often hardcode service-role keys.
# Force everyone to read from env vars instead.
setup-*.js
setup-*.ts

# Claude Code hook sentinel
.claude/.dirty

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel

# graphify knowledge-graph output — only the repo-root graphify-out/ is tracked.
# Stray copies inside src/ pollute editor indexing and the graph itself.
/src/**/graphify-out/
# graphify AST cache — large, reproducible, no value in git
graphify-out/cache/
